# Configuration email pour les alertes (SMTP standard gratuit)
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-adresse@gmail.com
SMTP_PASSWORD=votre-mot-de-passe-d-application
ALERT_EMAIL_RECIPIENT=destinataire@gmail.com

# URL de la plateforme pour la synchronisation
PLATFORM_SITEMAP_URL=https://drenolearn.com/sitemap.xml

# Configuration Supabase (DrenoLearn) pour création automatique des brouillons
SUPABASE_URL=https://mlztlexcgdhgnnmkuioc.supabase.co
# Clé secrète 'service_role' (trouvée dans Supabase > Project Settings > API > service_role)
# Elle permet d'insérer des bourses en mode brouillon (is_active = false)
SUPABASE_SERVICE_ROLE_KEY=votre_cle_secrete_service_role
GEMINI_API_KEY=votre_cle_gemini_api_gratuite

# Délai entre requêtes en secondes pour ménager la RAM et les sites
SCRAPE_DELAY_SECONDS=3
